{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Dev App",
      "request": "launch",
      "type": "dart",
      "toolArgs": ["--flavor", "dev", "--dart-define-from-file=config/dev.json"]
    },
    {
      "name": "Dev App Store",
      "request": "launch",
      "type": "dart",
      "toolArgs": [
        "--flavor",
        "dev",
        "--dart-define-from-file=config/dev.json",
        "--dart-define=DISTRIBUTION=store"
      ]
    },
    {
      "name": "Prod App Store",
      "request": "launch",
      "type": "dart",
      "toolArgs": [
        "--flavor",
        "prod",
        "--dart-define-from-file=config/prod.json",
        "--dart-define=DISTRIBUTION=store"
      ]
    },
    {
      "name": "Dev Web",
      "request": "launch",
      "type": "dart",
      "deviceId": "chrome",
      "toolArgs": [
        "--dart-define-from-file=config/dev.json",
        "--web-port=8080",
        "--web-browser-flag=--user-data-dir=/Users/sumetph/.flutter-chrome-profile"
      ]
    },
    {
      "name": "Dev Web Windows",
      "request": "launch",
      "type": "dart",
      "deviceId": "chrome",
      "toolArgs": ["--dart-define-from-file=config/dev.json", "--web-port=8080"]
    },
    {
      "name": "Dev Web Store",
      "request": "launch",
      "type": "dart",
      "deviceId": "chrome",
      "toolArgs": [
        "--dart-define-from-file=config/dev.json",
        "--web-port=8080",
        "--web-browser-flag=--user-data-dir=/Users/sumetph/.flutter-chrome-profile",
        "--dart-define=DISTRIBUTION=store"
      ]
    },
    {
      "name": "Dev Web Local",
      "request": "launch",
      "type": "dart",
      "deviceId": "chrome",
      "toolArgs": [
        "--dart-define-from-file=config/local.json",
        "--web-port=8080",
        "--web-browser-flag=--user-data-dir=/Users/sumetph/.flutter-chrome-profile"
      ]
    }
  ]
