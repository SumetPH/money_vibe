<?xml version="1.0" encoding="utf-8"?>
<!-- ไม่ backup ข้อมูลแอป (session token และ API key) ขึ้นคลาวด์หรือย้ายไปเครื่องอื่น -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
